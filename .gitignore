# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local Horror Aids workspace data
/data/
/stories/

# local worker/runtime config 
/config/local*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.development
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle introspect output (not part of the app)
drizzle/relations.ts
drizzle/schema.ts
**/__pycache__/

# native omnivoice.cpp checkout + build (built locally per-machine)
/workers/omnivoice.cpp/