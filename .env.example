OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=auto
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi
AUDIO_VERIFY_MAX_ATTEMPTS=3
AUDIO_VERIFY_MIN_TEXT_RATIO=0.6
HORROR_AIDS_FAKE_TTS=1
HORROR_AIDS_FAKE_WHISPER=1
# Required for the YouTube metadata generation feature (Metadata tab). Create
# a key at https://openrouter.ai/keys (it starts with "sk-or-v1-"). The target
# model and provider routing live in config/app.json (youtubeMetadata.model /
# .providerOnly / .allowFallbacks); OPENROUTER_BASE_URL below overrides the
# config base URL when set. OPENAI_API_KEY is still read as a fallback.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Required for the YouTube auto-upload feature (approving a story's final
# video uploads it to YouTube as Private automatically). Create these in
# Google Cloud Console: APIs & Services > Credentials > Create OAuth client
# ID > Web application, with an Authorized redirect URI of
# http://localhost:3000/api/youtube/oauth/callback (adjust the port to match
# whatever this app actually runs on). Also enable "YouTube Data API v3"
# under APIs & Services > Library for that project first.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only needed if this app runs on a port other than 3000 — must exactly
# match an Authorized redirect URI on the OAuth client above.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
